{
  "name": "gym-online-server",
  "version": "1.0.0",
  "description": "Backend cho game Gym Online (Express + Socket.IO + MongoDB)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "loadtest": "node tools/loadtest.js",
    "start:cluster": "node tools/cluster.js",
    "admin": "node tools/make-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=18.11"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "nodemailer": "^10.3.1",
    "redis": "^4.7.1",
    "socket.io": "^4.8.1",
    "socket.io-msgpack-parser": "^3.0.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
