# Cổng chạy server backend
PORT=4000

# Chuỗi kết nối MongoDB (local hoặc Atlas)
# Local:  mongodb://127.0.0.1:27017/gym_online
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gym_online
MONGODB_URI=mongodb://127.0.0.1:27017/gym_online

# Khóa bí mật ký JWT – HÃY đổi thành chuỗi ngẫu nhiên dài khi deploy
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-bi-mat-that-dai
JWT_EXPIRES_IN=7d

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ===== Mở rộng quy mô (tùy chọn) =====
# Redis: bật Socket.IO Redis adapter + registry channel + presence + cache dùng chung giữa nhiều instance
# REDIS_URL=redis://127.0.0.1:6379
# ID instance (mỗi tiến trình server 1 ID khác nhau khi chạy cluster)
# INSTANCE_ID=a
# URL công khai của instance này (client kết nối thẳng tới instance giữ channel). Để trống = cùng origin
# PUBLIC_URL=http://localhost:4001
# Số channel tạo sẵn khi khởi động
CHANNELS_INITIAL=1
# Bảo vệ /api/admin/metrics và cho phép bot load test kết nối (để trống = tắt)
ADMIN_SECRET=
LOADTEST_SECRET=
